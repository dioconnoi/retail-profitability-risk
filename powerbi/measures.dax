// =====================================================================================================
//  Retail Profitability, Demand Forecasting & Operational Risk  -  DAX measures
//  Data model: see powerbi/DASHBOARD_SPEC.md (star schema built from powerbi/model/*.csv)
//
//  HOW TO LOAD: create one table `_Measures` (Enter Data, one blank column, then hide the column). For each
//  measure: Modeling > New measure, paste the text of ONE measure (everything from its name to the next
//  blank line; the trailing `// format:` comments are guidance and may be dropped), then set the format and the
//  display folder named in the section header. Names are referenced across measures, so keep them exactly as
//  written. (This file is a readable reference, not a Tabular Editor DAX-script import.)
//
//  STATUS: these were written against the CSV schema but NOT executed (no Power BI engine was available
//  while authoring). Validate every measure against powerbi/model/reconciliation_expected.json (the
//  reconciliation table in DASHBOARD_SPEC.md) before trusting the visuals.
// =====================================================================================================


// ---------------------------------------------------------------------------------------------------
//  0. WHAT-IF PARAMETERS  (Modeling > New parameter). Each creates a table and a slicer.
//     COGS Rate      : Decimal, min 0.55, max 0.75, increment 0.01, default 0.65   -> table 'COGS Rate'
//     Freight Shock  : Decimal, min 0.00, max 0.50, increment 0.05, default 0.00   -> table 'Freight Shock'
//     Demand Shock   : Decimal, min -0.30, max 0.00, increment 0.05, default 0.00  -> table 'Demand Shock'
//  Power BI auto-creates "<Name> Value" measures; if you name the parameters as above they are equivalent to:
// ---------------------------------------------------------------------------------------------------
// Folder: 0 Parameters
COGS Rate Value = SELECTEDVALUE ( 'COGS Rate'[COGS Rate], 0.65 )            // format: 0%
Freight Shock Value = SELECTEDVALUE ( 'Freight Shock'[Freight Shock], 0 )   // format: 0%
Demand Shock Value = SELECTEDVALUE ( 'Demand Shock'[Demand Shock], 0 )      // format: 0%


// ---------------------------------------------------------------------------------------------------
//  1. PROFITABILITY  (Folder: 1 Profitability)  -  source: fact_sales (delivered orders, one row per item)
// ---------------------------------------------------------------------------------------------------
Gross Revenue = SUM ( fact_sales[price] )                                   // format: R$ #,##0
Freight = SUM ( fact_sales[freight_value] )                                 // format: R$ #,##0
Orders = DISTINCTCOUNT ( fact_sales[order_id] )                             // format: #,##0
Items = COUNTROWS ( fact_sales )                                            // format: #,##0
Customers = DISTINCTCOUNT ( fact_sales[customer_unique_id] )                // format: #,##0
Active Sellers = DISTINCTCOUNT ( fact_sales[seller_id] )                    // format: #,##0

Net of Freight (P1) = [Gross Revenue] - [Freight]                           // format: R$ #,##0

// P2 is a PROXY: Olist has no cost data. The COGS rate is a what-if parameter (default 65%).
Profit Proxy (P2) = [Gross Revenue] * ( 1 - [COGS Rate Value] ) - [Freight] // format: R$ #,##0

Profit Margin % = DIVIDE ( [Profit Proxy (P2)], [Gross Revenue] )           // format: 0.0%
AOV = DIVIDE ( [Gross Revenue], [Orders] )                                  // format: R$ #,##0.00
Items per Order = DIVIDE ( [Items], [Orders] )                              // format: 0.00
Freight Ratio = DIVIDE ( [Freight], [Gross Revenue] )                       // format: 0.0%

// Share of the revenue currently shown (respects slicers, ignores the visual's own axis)
Revenue Share % = DIVIDE ( [Gross Revenue], CALCULATE ( [Gross Revenue], ALLSELECTED () ) )   // format: 0.0%

// Customers with >= 2 delivered orders in the current filter context
Repeat Rate =
VAR perCustomer =
    SUMMARIZE ( fact_sales, fact_sales[customer_unique_id], "n", DISTINCTCOUNT ( fact_sales[order_id] ) )
RETURN
    DIVIDE ( COUNTROWS ( FILTER ( perCustomer, [n] >= 2 ) ), COUNTROWS ( perCustomer ) )      // format: 0.0%


// ---------------------------------------------------------------------------------------------------
//  2. TIME INTELLIGENCE  (Folder: 2 Time)  -  requires dim_date marked as the date table
// ---------------------------------------------------------------------------------------------------
Revenue Prior Month = CALCULATE ( [Gross Revenue], DATEADD ( dim_date[date], -1, MONTH ) )     // format: R$ #,##0
Revenue MoM % = DIVIDE ( [Gross Revenue] - [Revenue Prior Month], [Revenue Prior Month] )      // format: 0.0%

// Trailing 3-month average of monthly revenue (evaluate on a month axis)
Revenue 3M Avg =
VAR lastDay = MAX ( dim_date[date] )
RETURN DIVIDE ( CALCULATE ( [Gross Revenue], DATESINPERIOD ( dim_date[date], lastDay, -3, MONTH ) ), 3 )   // format: R$ #,##0

Orders Prior Month = CALCULATE ( [Orders], DATEADD ( dim_date[date], -1, MONTH ) )             // format: #,##0

// Running peak and drawdown of monthly revenue (evaluate on dim_date[month_start])
Revenue Running Peak =
VAR d = MAX ( dim_date[month_start] )
RETURN
    MAXX ( FILTER ( ALL ( dim_date[month_start] ), dim_date[month_start] <= d ), [Gross Revenue] )   // format: R$ #,##0
Drawdown % = DIVIDE ( [Gross Revenue], [Revenue Running Peak] ) - 1                            // format: 0.0%


// ---------------------------------------------------------------------------------------------------
//  3. CONCENTRATION  (Folder: 3 Concentration)  -  HHI on a 0-10,000 scale
//     <1,500 unconcentrated | 1,500-2,500 moderate | >2,500 high
// ---------------------------------------------------------------------------------------------------
Seller HHI =
VAR total = CALCULATE ( [Gross Revenue], ALLSELECTED ( dim_seller ) )
RETURN
    SUMX ( VALUES ( dim_seller[seller_id] ), POWER ( DIVIDE ( [Gross Revenue], total ), 2 ) ) * 10000   // format: #,##0

Category HHI =
VAR total = CALCULATE ( [Gross Revenue], ALLSELECTED ( dim_category ) )
RETURN
    SUMX ( VALUES ( dim_category[category_en] ), POWER ( DIVIDE ( [Gross Revenue], total ), 2 ) ) * 10000 // format: #,##0

State HHI =
VAR total = CALCULATE ( [Gross Revenue], ALLSELECTED ( dim_customer_state ) )
RETURN
    SUMX ( VALUES ( dim_customer_state[state] ), POWER ( DIVIDE ( [Gross Revenue], total ), 2 ) ) * 10000 // format: #,##0

Seller Effective N = DIVIDE ( 10000, [Seller HHI] )                          // format: #,##0

Top 10 Seller Share =
DIVIDE (
    SUMX ( TOPN ( 10, VALUES ( dim_seller[seller_id] ), [Gross Revenue] ), [Gross Revenue] ),
    [Gross Revenue]
)                                                                            // format: 0.0%

Top 20% Seller Share =
VAR n = ROUNDUP ( 0.2 * [Active Sellers], 0 )
RETURN
    DIVIDE ( SUMX ( TOPN ( n, VALUES ( dim_seller[seller_id] ), [Gross Revenue] ), [Gross Revenue] ), [Gross Revenue] )   // format: 0.0%


// ---------------------------------------------------------------------------------------------------
//  4. OPERATIONAL RISK  (Folder: 4 Risk)  -  source: fact_orders (all in-window orders, any status)
//     Risk columns are BLANK where they do not apply, so COUNT() ignores them correctly.
// ---------------------------------------------------------------------------------------------------
All Orders = COUNTROWS ( fact_orders )                                       // format: #,##0
Failed Orders = SUM ( fact_orders[is_failed] )                               // format: #,##0
Cancellation Rate = DIVIDE ( [Failed Orders], [All Orders] )                 // format: 0.00%

Late Orders = SUM ( fact_orders[is_late] )                                   // format: #,##0
Late Evaluable Orders = COUNT ( fact_orders[is_late] )                       // delivered orders with a delivery date
Late Rate = DIVIDE ( [Late Orders], [Late Evaluable Orders] )                // format: 0.0%   (calendar-day rule; conditional on delivery)

Low Review Orders = SUM ( fact_orders[is_low] )                              // format: #,##0
Reviewed Orders = COUNT ( fact_orders[review_score] )                        // format: #,##0
Low Review Rate = DIVIDE ( [Low Review Orders], [Reviewed Orders] )          // format: 0.0%
Avg Review Score = AVERAGE ( fact_orders[review_score] )                     // format: 0.00

Avg Delivery Days = AVERAGE ( fact_orders[delivery_days] )                   // format: 0.0
Avg Promised Days = CALCULATE ( AVERAGE ( fact_orders[promised_days] ), fact_orders[is_delivered] = 1, NOT ISBLANK ( fact_orders[delivery_days] ) )  // format: 0.0

Delivered Order Revenue = SUM ( fact_orders[revenue] )                       // format: R$ #,##0 ; equals [Gross Revenue]
At-Risk Revenue = CALCULATE ( SUM ( fact_orders[revenue] ), fact_orders[at_risk] = 1 )   // late OR 1-2 stars, counted once
At-Risk % = DIVIDE ( [At-Risk Revenue], [Delivered Order Revenue] )          // format: 0.0%
Lost Revenue (failed orders) = SUM ( fact_orders[failed_item_value] )        // format: R$ #,##0 ; items on canceled/unavailable orders

// Effect of lateness on reviews (association, not proof of cause)
Low Review Rate if Late = CALCULATE ( [Low Review Rate], fact_orders[is_late] = 1 )    // format: 0.0%
Low Review Rate if On Time = CALCULATE ( [Low Review Rate], fact_orders[is_late] = 0 ) // format: 0.0%
Lateness Multiplier = DIVIDE ( [Low Review Rate if Late], [Low Review Rate if On Time] )  // format: 0.0"x"

// Late-delivery bucket for the "cost of lateness" chart (add as a calculated column on fact_orders)
// Lateness Bucket =
//     SWITCH ( TRUE (),
//         ISBLANK ( fact_orders[days_late] ), BLANK (),
//         fact_orders[days_late] = 0, "1 On time",
//         fact_orders[days_late] <= 3, "2 1-3 days late",
//         fact_orders[days_late] <= 7, "3 4-7 days late",
//         "4 8+ days late" )


// ---------------------------------------------------------------------------------------------------
//  5. STRESS TESTS  (Folder: 5 Scenarios)  -  driven by the three what-if sliders
//     Demand scales revenue AND freight (variable costs only); freight shock scales the freight rate.
// ---------------------------------------------------------------------------------------------------
Revenue under Shock = [Gross Revenue] * ( 1 + [Demand Shock Value] )         // format: R$ #,##0

Profit under Shock (P2) =
VAR d = 1 + [Demand Shock Value]
VAR f = 1 + [Freight Shock Value]
RETURN d * ( [Gross Revenue] * ( 1 - [COGS Rate Value] ) - f * [Freight] )   // format: R$ #,##0

Profit Change vs Baseline = [Profit under Shock (P2)] - [Profit Proxy (P2)]  // format: R$ #,##0
Profit Change % = DIVIDE ( [Profit Change vs Baseline], [Profit Proxy (P2)] ) // format: 0.0%

// Freight is often larger than the whole profit proxy: each 1% freight rise costs this many % of profit
Freight Leverage = DIVIDE ( [Freight], [Profit Proxy (P2)] )                 // format: 0.00

// Extra revenue exposed to a bad experience if the late rate doubles: revenue x p_late x (1 - q),
// where q = 1-2 star rate among on-time orders. EXPOSURE, not realised loss.
Late Rate Doubles: Extra At-Risk Revenue =
VAR pLate = [Late Rate]
VAR q = [Low Review Rate if On Time]
RETURN [Delivered Order Revenue] * pLate * ( 1 - q )                         // format: R$ #,##0


// ---------------------------------------------------------------------------------------------------
//  6. FORECAST  (Folder: 6 Forecast)  -  source: fact_forecast (disconnected table; use its own month axis)
// ---------------------------------------------------------------------------------------------------
Actual Orders = CALCULATE ( SUM ( fact_forecast[orders] ), fact_forecast[series] = "Actual" )                  // format: #,##0
Forecast Orders = CALCULATE ( SUM ( fact_forecast[orders] ), fact_forecast[series] = "Forecast" )              // format: #,##0
Forecast Low (80%) = CALCULATE ( SUM ( fact_forecast[lo80] ), fact_forecast[series] = "Forecast" )             // format: #,##0
Forecast High (80%) = CALCULATE ( SUM ( fact_forecast[hi80] ), fact_forecast[series] = "Forecast" )            // format: #,##0
Black-Friday Scenario Orders = CALCULATE ( SUM ( fact_forecast[orders] ), fact_forecast[series] = "Black-Friday scenario" )  // format: #,##0
Forecast Revenue (3 months) = CALCULATE ( SUM ( fact_forecast[revenue] ), fact_forecast[series] = "Forecast" ) // format: R$ #,##0
Forecast Revenue per Month = DIVIDE ( [Forecast Revenue (3 months)], 3 )                                       // format: R$ #,##0


// ---------------------------------------------------------------------------------------------------
//  7. SELLER WATCHLIST  (Folder: 7 Watchlist)  -  source: fact_seller_watchlist (top 100 active sellers)
// ---------------------------------------------------------------------------------------------------
Watchlist Sellers = DISTINCTCOUNT ( fact_seller_watchlist[seller_id] )                     // format: #,##0
Expected Profit at Risk = SUM ( fact_seller_watchlist[expected_profit_at_risk] )           // format: R$ #,##0 ; P(inactive) x 90-day profit
Profit at Stake (90d) = SUM ( fact_seller_watchlist[run_rate_profit_90d] )                 // format: R$ #,##0
Avg P(Inactive) = AVERAGE ( fact_seller_watchlist[p_inactive] )                            // format: 0%
Avg Days Since Last Order = AVERAGE ( fact_seller_watchlist[days_since_last] )             // format: 0


// ---------------------------------------------------------------------------------------------------
//  8. MODEL SCORECARD  (Folder: 8 Models)  -  source: tbl_model_scorecard (disconnected)
//     Matrix: rows = model + variant, columns = metric, values = [Model Metric Value]
// ---------------------------------------------------------------------------------------------------
Model Metric Value = AVERAGE ( tbl_model_scorecard[value] )                                // format per metric: 0.000


// ---------------------------------------------------------------------------------------------------
//  9. DYNAMIC TITLES  (Folder: 9 Titles)  -  bind to visual titles via fx so headlines never go stale
// ---------------------------------------------------------------------------------------------------
Title Revenue =
"Revenue R$ " & FORMAT ( [Gross Revenue] / 1000000, "0.00" ) & "M across " & FORMAT ( [Orders], "#,##0" ) & " delivered orders"

Title Margin =
"Profit proxy margin " & FORMAT ( [Profit Margin %], "0.0%" ) & " at " & FORMAT ( [COGS Rate Value], "0%" ) & " COGS: freight takes " & FORMAT ( [Freight Ratio], "0%" ) & " of price"

Title Late =
"Late rate " & FORMAT ( [Late Rate], "0.0%" ) & "; a late order is " & FORMAT ( [Lateness Multiplier], "0.0" ) & "x as likely to get 1-2 stars"

Title Concentration =
"Seller HHI " & FORMAT ( [Seller HHI], "#,##0" ) & ": top 20% of sellers earn " & FORMAT ( [Top 20% Seller Share], "0%" ) & " of revenue"
